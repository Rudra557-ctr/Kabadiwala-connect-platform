# ---------------------------------------------------------------------------
# Kabadiwala Connect — environment
# Copy to .env.local and fill in. The app runs WITHOUT any of these in demo
# mode (local IndexedDB only), so you can develop before Supabase is set up.
# ---------------------------------------------------------------------------

# Supabase (free tier). Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude vision API — the ONLINE "enhanced accuracy" classification path.
# Optional. Without it the app falls back to the offline TF.js model, which is
# the primary path anyway (48-HOUR-PLAN §5).
# Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Demo mode: 'true' seeds everything locally and never calls Supabase.
# Keep this ON for the hackathon demo so venue Wi-Fi cannot break the run.
NEXT_PUBLIC_DEMO_MODE=true
